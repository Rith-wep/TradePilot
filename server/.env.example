# Copy to .env for local development. The application does not load this file
# automatically; export the values through your shell or container runtime.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://tradepilot:tradepilot@localhost:54329/tradepilot
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_READY_TIMEOUT_MS=1000

# Trusted internal Python verification boundary. Never accept these from clients.
TRADEPILOT_PYTHON_EXECUTABLE=..\research\.venv\Scripts\python.exe
TRADEPILOT_PYTHON_WORKING_DIRECTORY=..\research
TRADEPILOT_CONTRACT_SCHEMA_DIRECTORY=..\research\contracts
TRADEPILOT_DATA_ROOT=..\research\data
TRADEPILOT_REPORT_ROOT=..\research\reports
TRADEPILOT_VERIFIER_TIMEOUT_MS=10000
TRADEPILOT_VERIFIER_MAX_INPUT_BYTES=65536
TRADEPILOT_VERIFIER_MAX_OUTPUT_BYTES=1048576
TRADEPILOT_VERIFIER_MAX_ERROR_BYTES=16384
TRADEPILOT_VERIFIER_MAX_CONCURRENCY=2
TRADEPILOT_VERIFIER_MAX_PENDING_REQUESTS=16
