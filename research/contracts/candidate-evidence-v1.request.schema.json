{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradepilot.local/contracts/candidate-evidence-v1.request.schema.json",
  "title": "TradePilot candidate evidence request v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request_id", "operation", "report_id", "offset", "limit"],
      "properties": {
        "contract_version": { "const": "tradepilot-candidate-evidence/v1" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "operation": { "const": "list_candidates" },
        "report_id": { "$ref": "#/$defs/sha256" },
        "offset": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request_id", "operation", "evidence_id"],
      "properties": {
        "contract_version": { "const": "tradepilot-candidate-evidence/v1" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "operation": { "const": "get_evidence" },
        "evidence_id": { "$ref": "#/$defs/evidenceId" }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "evidenceId": { "type": "string", "pattern": "^[0-9a-f]{64}\\.[0-9]{8}\\.[0-9a-f]{64}$" }
  }
}
