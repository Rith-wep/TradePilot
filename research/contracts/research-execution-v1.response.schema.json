{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "status", "dataset_id", "report_id", "strategy_name", "strategy_version", "signal_count", "reused"],
      "properties": {
        "contract_version": {"const": "tradepilot-research-execution/v1"}, "request_id": {"type": "string"},
        "status": {"const": "SUCCEEDED"}, "dataset_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "report_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "strategy_name": {"type": "string"},
        "strategy_version": {"type": "string"}, "signal_count": {"type": "integer", "minimum": 0}, "reused": {"type": "boolean"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "status", "error"],
      "properties": {
        "contract_version": {"const": "tradepilot-research-execution/v1"}, "request_id": {"type": "string"},
        "status": {"const": "ERROR"},
        "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"],
          "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}}
      }
    }
  ]
}
